  "asset_boundary": "The original Java snapshot declares these state icon paths but omits their PNG files. The retained _w snapshot supplies 9 PNGs and 3 animation metadata files without modifications. Existing colored/idle textures are reused.",
  "behavior": {
    "all_facing_default": "UP; 6 allowed directions; pitch threshold inclusive at +/-65 degrees",
    "tools": "WRENCH rotates through the existing 3x3 selected-face interaction; SOFT_HAMMER rescans without toggling stopped; MAGNIFYING_GLASS reports receiver/sender/target coordinates",
    "tool_click_returns": {
      "wrench": 10000,
      "soft_hammer": 10000,
      "magnifying_glass": 1
    },
    "stack_limit": 16,
    "materials": {
      "item_endpoint": "Platinum",
      "fluid_endpoint": "Tungsten",
      "EV": "Chromium",
      "IV": "Titanium",
      "LuV": "Iridium",
      "ZPM": "OsmiumElemental",
      "UV": "Trinitanium"
    },
    "receiver_selection": "Breadth-first same block/meta identity, first front attached receiver; branches permitted. One receiver is owned by one live sender; a competing sender cannot skip it to steal another receiver.",
    "chunk_policy": "Initial scan reads/generates its path chunks; cached routing remembers target coordinates and does not reload path chunks. A missing target is unavailable.",
    "energy_loss": "Signed packets retain sign, each loses max(64, distance/8) EU; receiver output uses its back face",
    "injection_order": "TileEntityBase01Root checks accepting/target before calling doInject. An unconnected endpoint rejects even an oversized packet without overcharging; a connected endpoint consumes undersized packets per the root minimum-size gate.",
    "activity_history": "The recent 64-tick history is retained while stopped or waiting for an unavailable remembered target.",
    "state_boundary": "0 idle/stopped, 1 continuous, 2 intermittent, 3 remembered unavailable target. State 3 uses the intended remembered unavailable condition instead of the original compound check which also inspects target ownership."
  },
  "retained_mapping_boundary": "Stable legacy transformer suffixes ulv/lv/mv represent the actual original EV/IV/LuV voltages, respectively; IDs are not renamed."
}
