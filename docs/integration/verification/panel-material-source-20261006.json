  "adopted_rules": {
    "CR_REV": "Known ingredient data only; no tools; automatic ore dictionary data for OP.screw.dat(ANY.Iron); sum before integer division by result stack size; keep previous item data.",
    "components": "Sort merged known amounts descending before per-output flooring. ANY.Iron native identity uses its existing concrete Iron output, never picks one arbitrary matching screw.",
    "construction": "BlockConcrete/BlockAsphalt 1U full / U/2 slab; BlockColored supplies CFoam/Fresh 1U and CFoam slab U/2. Reinforced Concrete adds OP.stick (U/2) iron.",
    "panels": "Six screws at U/9 each plus one known input, output six, giving U/9 Iron + U/6 construction/plank per panel.",
    "scope": "83 panel identities including legacy aliases, six present construction items, missing native GT plank bindings. Existing vanilla plank compositions preserved; their generic modern/original-species identity audit remains separate. No guessing of absent slabs or external plank items.",
    "recovery": "Reuse existing native RecipeMapShredder bindings and material recovery consumption safeguards. Finite native and ordinary installed verification still pending.",
    "brittle_recovery_work": "Use the existing original BRITTLE/FOOD tables for RecipeMapShredder work, including foam at 2*(quality+1), not 256*(quality+1). No claim of full remaining STRETCHY/BOUNCY/MEAT/ROTTEN classifier audit."
  },
  "language": "No localization resources modified; existing original patch values preserved."
}
